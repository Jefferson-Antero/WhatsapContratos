# APP_URL: URL onde o frontend está hospedado. Usado para CORS.
APP_URL="http://localhost:3001"

# PORT: Porta do servidor Express.
PORT=3001

# API_TOKEN: Token de autenticação da API (opcional).
# Se definido, todas as requisições à API devem incluir o header:
#   Authorization: Bearer <seu_token>
# Gere um token seguro com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_TOKEN="seu_token_secreto_aqui"

# GEMINI_API_KEY: Chave da API Gemini (usar apenas no servidor, nunca no frontend).
# GEMINI_API_KEY="sua_chave_aqui"
